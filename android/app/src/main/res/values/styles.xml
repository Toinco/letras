<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mientras arranca el proceso: siempre oscuro, con o sin modo oscuro
         del sistema (la app es solo oscura). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
    </style>
    <!-- Detrás de la UI de Flutter mientras inicializa y mientras corre. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
